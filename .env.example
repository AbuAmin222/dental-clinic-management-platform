APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dental_clinic
DB_USERNAME=root
DB_PASSWORD=your_secure_password
# كلمة مرور root الخاصة بحاوية MySQL نفسها فقط (docker-compose.yml) — مختلفة عن DB_PASSWORD
# أعلاه إن لم يكن DB_USERNAME هو root؛ إن كانا نفس المستخدم يجب أن تتطابق القيمتان.
DB_ROOT_PASSWORD=your_root_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# بوابات الدفع (config/services.php) — كل مفتاح هنا يقابل حرفياً مفتاحاً في ذلك الملف.
# اتركها فارغة في بيئة التطوير/الاختبار؛ Sandbox القيمة الافتراضية لكل base_url أصلاً.
# ------------------------------------------------------------------------------
JAWWAL_PAY_MERCHANT_ID=
JAWWAL_PAY_SECRET_KEY=
JAWWAL_PAY_BASE_URL=https://checkout.jawwalpay.ps

BOP_MERCHANT_ID=
BOP_PASSWORD=
BOP_BASE_URL=https://bop.gateway.mastercard.com

PALPAY_MERCHANT_ID=demo_merchant
PALPAY_BASE_URL=https://sandbox.palpay.ps

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://www.sandbox.paypal.com

# سعر تحويل الشيكل للدولار المستخدَم عند معالجة دفعات PayPal (App\Services\PaymentGateway\CurrencyConverter)
ILS_TO_USD_RATE=0.27

# ------------------------------------------------------------------------------
# قيم عمل العيادة القابلة للضبط (config/clinic.php) — كل قيمة اختيارية، القيمة الافتراضية
# المكتوبة هنا هي نفسها المستخدَمة في الكود إن تُركت المتغيرات هذه فارغة/غير معرَّفة.
# ------------------------------------------------------------------------------
CLINIC_MONEY_MINOR_UNIT_FACTOR=100
CLINIC_APPOINTMENT_DEFAULT_DURATION_MINUTES=30

CLINIC_RISK_AMOUNT_THRESHOLD_MINOR_UNITS=500000
CLINIC_RISK_AMOUNT_THRESHOLD_POINTS=40
CLINIC_RISK_VELOCITY_LOOKBACK_MINUTES=15
CLINIC_RISK_VELOCITY_ATTEMPT_THRESHOLD=4
CLINIC_RISK_VELOCITY_POINTS=35
CLINIC_RISK_HOLD_THRESHOLD=70

# ⚠️ يجب أن تبقى القيمتان التاليتان ≤ client_max_body_size في docker/nginx.conf (راجع
# التعليق هناك) و ≤ upload_max_filesize/post_max_size في إعدادات PHP الفعلية.
CLINIC_UPLOAD_XRAY_MAX_KB=5120
CLINIC_UPLOAD_IDENTITY_MAX_KB=4096

CLINIC_TOOTH_NUMBER_MIN=1
CLINIC_TOOTH_NUMBER_MAX=32

CLINIC_PAGINATION_DEFAULT=15
CLINIC_PAGINATION_FINANCIAL=20

# ------------------------------------------------------------------------------
# Docker Compose (docker-compose.yml) — منافذ الاستضافة (Host Ports) القابلة للتخصيص
# لتشغيل أكثر من نسخة على نفس الخادم دون تعارض منافذ، ومرجع الصورة المنشورة عبر CI/CD.
# ------------------------------------------------------------------------------
APP_PORT=8010
DB_FORWARD_PORT=3310
REDIS_FORWARD_PORT=6380

DOCKER_IMAGE_REPOSITORY=ghcr.io/your-org/dental-clinic-application
IMAGE_TAG=latest

# تشغيل الزرع الأولي (Seeders) تلقائياً عند إقلاع الحاوية — true عند التهيئة الأولى فقط،
# ثم يجب إعادته إلى false (راجع docker/entrypoint.sh لتفاصيل خطر تكرار البيانات).
CLINIC_RUN_SEED_ON_BOOT=false
